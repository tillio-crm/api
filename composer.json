{
    "name": "tillio-crm/api",
    "description": "Official PHP SDK for Tillio API v2 - typed DTOs, both connection modes (direct API key and marketplace proxy), built-in retry and rate limiting. Documentation in Polish.",
    "type": "library",
    "license": "MIT",
    "keywords": ["tillio", "tillio-crm", "crm", "api", "api-client", "sdk", "rest"],
    "homepage": "https://github.com/tillio-crm/api",
    "authors": [
        {
            "name": "Łukasz Gorący",
            "email": "l.goracy@tillio.pl"
        }
    ],
    "support": {
        "issues": "https://github.com/tillio-crm/api/issues",
        "source": "https://github.com/tillio-crm/api"
    },
    "require": {
        "php": "^8.3",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "TillioCrm\\Api\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TillioCrm\\Api\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
